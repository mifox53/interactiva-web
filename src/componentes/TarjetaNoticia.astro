---
import { fechaLarga, NOMBRES_CATEGORIA } from '../lib/util.js';
const { noticia, grande = false } = Astro.props;
const d = noticia.data;
---
<a class:list={['noticia', { grande }]} href={`/noticias/${noticia.id}/`}>
  <div class="noticia-img" style={d.imagen ? `background-image:url('${d.imagen}')` : ''} data-cat={d.categoria}></div>
  <div class="noticia-txt">
    <span class="k">{NOMBRES_CATEGORIA[d.categoria]}</span>
    <h3>{d.titulo}</h3>
    {grande && <p>{d.resumen}</p>}
    <small>{fechaLarga(d.fecha)} · Fuente: {d.fuenteNombre}</small>
  </div>
</a>
