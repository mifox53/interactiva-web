---
// Página para enlaces rotos o direcciones mal escritas. La mascota y su nombre salen de sitio.json.
import Base from '../layouts/Base.astro';
import sitio from '../datos/sitio.json';
const m = sitio.mascota;
---
<Base titulo="Página no encontrada" descripcion="Esta página no existe o cambió de dirección.">
  <section class="bloque wrap error404">
    {m && <img class="error404-artie" src={m.cuerpo} alt={`${m.nombre}, la mascota de la emisora`} width="547" height="720" decoding="async" />}
    <div>
      <span class="k">Error 404</span>
      <h1>Esta página se fue de gira.</h1>
      <p class="bajada">{m ? `${m.nombre} la buscó` : 'La buscamos'} por toda la emisora y no la encontró. Puede que el enlace esté mal escrito o que la página ya no exista.</p>
      <div class="hero-acc">
        <a class="btn lleno" href="/">Ir al inicio</a>
        <a class="btn" href="/noticias/">Ver noticias</a>
        <a class="btn" href="/artistas/">Conocer a los artistas</a>
      </div>
    </div>
  </section>
</Base>
