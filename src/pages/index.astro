---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EspacioPatrocinante from '../componentes/EspacioPatrocinante.astro';
import TarjetaNoticia from '../componentes/TarjetaNoticia.astro';
import FichaArtista from '../componentes/FichaArtista.astro';
import ArtistaSemana from '../componentes/ArtistaSemana.astro';
import sitio from '../datos/sitio.json';
import patro from '../datos/patrocinantes.json';
import programacion from '../datos/programacion.json';
import { wa, fechaLarga, ordenarArtistas, paginaArtista } from '../lib/util.js';

// Noticias publicadas, la más reciente primero (la destacada sube al inicio)
const noticias = (await getCollection('noticias', (n) => !n.data.borrador))
  .sort((a, b) => Number(b.data.destacada) - Number(a.data.destacada) || b.data.fecha - a.data.fecha)
  .slice(0, 5);

const artistas = ordenarArtistas(await getCollection('artistas'));
// En la portada se muestran como máximo estos; el resto está en /artistas/
const EN_PORTADA = 8;

// Eventos y saludos publicados (el filtro por fecha se termina de aplicar en el navegador)
const eventos = (await getCollection('eventos', (e) => !e.data.borrador)).sort((a, b) => a.data.fecha - b.data.fecha);

// Portada: 4 artistas. Si hay más de 4, el navegador elige 4 al azar y cambia cada 10 minutos.
const degradados = [
  'linear-gradient(160deg,#ff5fd2,#5b1fd6)', 'linear-gradient(160deg,#8b3dff,#161a55)',
  'linear-gradient(160deg,#19e0e6,#2a2fb8)', 'linear-gradient(160deg,#ff7a3d,#b01f8f)',
];
const huecos = [
  { etiqueta: 'Artista local', nombre: 'Próximamente' },
  { etiqueta: 'Artista internacional', nombre: 'Próximamente' },
  { etiqueta: 'Nuevo talento', nombre: 'Tu música aquí' },
  { etiqueta: 'Artista local', nombre: 'Próximamente' },
];
const etiquetaDe = (a) => (a.data.destacado ? 'Artista destacado' : a.data.tipo ? `Artista ${a.data.tipo}` : 'Artista');
// Solo rotan en la portada los artistas que ya tienen foto
// Las tarjetas de la portada llevan a la página del artista dentro del sitio (allí está su saludo e Instagram)
const paraPortada = artistas.filter((a) => a.data.foto).map((a) => ({
  etiqueta: etiquetaDe(a), nombre: a.data.nombre, foto: a.data.foto ?? '', enlace: paginaArtista(a),
}));
const portada = [0, 1, 2, 3].map((i) => paraPortada[i] ?? { ...huecos[i], foto: '', enlace: '#artistas' });

const franja = patro.patrocinantes.filter((p) => p.activo && p.espacios.includes('franja'));
const directorio = patro.patrocinantes.filter((p) => p.activo && p.espacios.includes('directorio'));
// Primero los que ya tienen foto; los demás esperan en /artistas/ hasta que llegue la suya
const enPortada = [...artistas.filter((a) => a.data.foto), ...artistas.filter((a) => !a.data.foto)].slice(0, EN_PORTADA);
const fichasLibres = enPortada.length % 4 === 0 ? 0 : 4 - (enPortada.length % 4);
---
<Base>
  <!-- ============ PORTADA ============ -->
  <div class="hero" id="inicio">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <span class="k">{sitio.lema}</span>
          <h1>La radio que le da <em>PLAY</em> a los artistas.</h1>
          <p class="sub">{sitio.slogan2} Desde Mérida para el mundo.</p>
          <div class="regla"></div>
          <div class="hero-acc">
            <a class="btn lleno" href="#en-vivo">▶ Escuchar en vivo</a>
            <a class="btn" href="#artistas">Conoce a los artistas</a>
          </div>
        </div>
        <div class="escena" aria-label="Artistas de iNteractiva" data-portada>
          {portada.map((c, i) => (
            <a class={`art a${i}`} href={c.enlace} target={c.enlace.startsWith('http') ? '_blank' : undefined} rel="noopener" data-degradado={degradados[i]}
               style={`--g:${c.foto ? `url('${c.foto}')` : degradados[i]}`}>
              <b><small>{c.etiqueta}</small><span>{c.nombre}</span></b>
            </a>
          ))}
        </div>
        <script type="application/json" id="artistas-portada" set:html={JSON.stringify(paraPortada)}></script>
      </div>

      <div class="esp-fila">
        <EspacioPatrocinante espacio="vip" />
        <EspacioPatrocinante espacio="premium" />
      </div>

      <div class="franja">
        <span class="k">{patro.espacios.franja.titulo}</span>
        <div class="logos">
          {franja.map((p) => (
            <a class="casilla" href={p.enlace} target="_blank" rel="noopener sponsored" title={p.nombre}
               data-patrocinante={p.id} data-desde={p.desde} data-hasta={p.hasta}>
              <img src={p.logo} alt={p.nombre} loading="lazy" />
            </a>
          ))}
          {Array.from({ length: patro.espacios.franja.casillasLibres }).map(() => (
            <a class="casilla libre" href={wa('Hola, quiero que mi logo aparezca en iNteractiva')} target="_blank" rel="noopener">Tu logo aquí</a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- ============ NOTICIAS ============ -->
  <section class="bloque wrap" id="noticias">
    <div class="cab"><h2>Mérida ahora</h2>{noticias.length > 0 && <a href="/noticias/">Ver todas →</a>}</div>
    <p class="bajada">Agricultura, café, cultura, eventos y deportes de nuestra ciudad.</p>
    {noticias.length > 0 ? (
      <div class:list={['noticias', { una: noticias.length === 1 }]}>
        <TarjetaNoticia noticia={noticias[0]} grande />
        <div class="lista">{noticias.slice(1).map((n) => <TarjetaNoticia noticia={n} />)}</div>
      </div>
    ) : (
      <div class="vacio">
        <strong>Muy pronto</strong>
        <span>Aquí aparecerán cada semana las noticias más relevantes de Mérida.</span>
      </div>
    )}
  </section>

  <!-- ============ ARTISTAS ============ -->
  <section class="bloque wrap" id="artistas">
    <div class="cab"><h2>Artistas</h2><a href="/artistas/">Ver todos ({artistas.length}) →</a></div>
    <p class="bajada">Artistas locales e internacionales que suenan en la 89.7.</p>
    <ArtistaSemana artistas={artistas} />
    <div class="rejilla desliza">
      {enPortada.map((a, n) => <FichaArtista artista={a} n={n} />)}
      {Array.from({ length: fichasLibres }).map((_, i) => (
        <a class="ficha libre" href={wa('Hola, soy artista y quiero mi ficha en iNteractiva')} target="_blank" rel="noopener">
          <span class="k">{i % 2 ? 'Artista internacional' : 'Artista local'}</span>
          <strong>Próximamente</strong>
          <small>¿Eres artista? Pide tu ficha →</small>
        </a>
      ))}
    </div>
    {artistas.length > EN_PORTADA && <p class="mas"><a class="btn" href="/artistas/">Ver los {artistas.length} artistas →</a></p>}
  </section>

  <!-- ============ AGENDA: EVENTOS Y SALUDOS ============ -->
  <section class="bloque wrap" id="agenda">
    <div class="cab"><h2>Agenda y saludos</h2></div>
    <p class="bajada">Eventos y saludos publicados por artistas y negocios.</p>
    <div class="agenda desliza" data-agenda>
      {eventos.map((e) => (
        <a class="evento" href={e.data.enlace || undefined} target="_blank" rel="noopener"
           data-vence={(e.data.hasta ?? e.data.fecha).toISOString().slice(0, 10)}>
          {e.data.patrocinado && <span class="patro">Patrocinado</span>}
          <span class="dia">{e.data.tipo === 'saludo' ? 'Saludo' : fechaLarga(e.data.fecha)}</span>
          <h3>{e.data.titulo}</h3>
          <p>{[e.data.artista, e.data.lugar].filter(Boolean).join(' · ')}</p>
        </a>
      ))}
      <a class="evento vacio" href={wa('Hola, quiero publicar un evento o saludo en la agenda de iNteractiva')} target="_blank" rel="noopener">
        <span class="dia">Publica aquí</span>
        <strong>¿Tienes un evento o un saludo?</strong>
        <span>Envíalo por WhatsApp y lo publicamos →</span>
      </a>
    </div>
  </section>

  <!-- ============ PROGRAMACIÓN ============ -->
  <section class="bloque wrap" id="programacion">
    <div class="cab"><h2>Programación</h2></div>
    <p class="bajada">Lo que suena en iNteractiva.</p>
    <div class="parrilla">
      {programacion.map((p) => (
        <div class="fila">
          <div><h3>{p.programa}</h3><p>{p.detalle}</p></div>
          <div class="h">{p.dias}<br />{p.hora}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ EMPRESAS ============ -->
  <section class="bloque wrap" id="empresas">
    <div class="cab"><h2>{patro.espacios.directorio.titulo}</h2></div>
    <p class="bajada">Las marcas que nos acompañan y el espacio para la tuya.</p>
    <div class="directorio desliza">
      {directorio.map((p) => (
        <div class="neg" data-patrocinante={p.id} data-desde={p.desde} data-hasta={p.hasta}>
          <span class="k">{[p.categoria, p.nivel].filter(Boolean).join(' · ')}</span>
          <strong>{p.nombre}</strong>
          {p.lema && <small>{p.lema}</small>}
          {p.direccion && <small>{p.direccion}</small>}
          <span class="neg-enl">
            <a href={p.enlace} target="_blank" rel="noopener sponsored">Visitar →</a>
            {p.video && <a href={p.video} target="_blank" rel="noopener sponsored">Ver video →</a>}
          </span>
        </div>
      ))}
      <a class="neg libre" href="/anunciate/">
        <span class="k">Tu negocio aquí</span>
        <strong>Espacio disponible</strong>
        <small>Conoce cómo anunciarte →</small>
      </a>
    </div>
  </section>

  <!-- ============ CIERRE: ANÚNCIATE Y CONTACTO ============ -->
  <section class="bloque wrap" id="contacto">
    <div class="contacto">
      <div>
        <h2>Pon tu negocio, tu evento o tu música</h2>
        <p>Publicidad, saludos o información general. Escríbenos a <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></p>
      </div>
      <div class="hero-acc">
        <a class="btn" href="/anunciate/">Cómo anunciarte</a>
        <a class="btn lleno" href={wa()} target="_blank" rel="noopener">WhatsApp · {sitio.whatsappTexto}</a>
      </div>
    </div>
  </section>

  <script is:inline>
    // Oculta eventos y saludos vencidos
    const hoyAg = new Date().toISOString().slice(0, 10);
    document.querySelectorAll('[data-vence]').forEach((el) => { if (el.dataset.vence < hoyAg) el.remove(); });

    // Portada: con más de 4 artistas, elige 4 al azar y cambia la selección cada 10 minutos
    // (todos los visitantes ven los mismos cuatro en cada tramo de 10 minutos).
    (function () {
      const MINUTOS = 10;
      const base = JSON.parse(document.getElementById('artistas-portada').textContent);
      if (base.length <= 4) return;
      const tramoActual = () => Math.floor(Date.now() / (MINUTOS * 60000));
      let pintado = -1;
      function pintar() {
        const tramo = tramoActual();
        if (tramo === pintado) return;
        pintado = tramo;
        let semilla = tramo >>> 0;
        const azar = () => {
          semilla = (semilla + 0x6d2b79f5) >>> 0;
          let t = Math.imul(semilla ^ (semilla >>> 15), 1 | semilla);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
        const todos = base.slice();
        for (let i = todos.length - 1; i > 0; i--) {
          const j = Math.floor(azar() * (i + 1));
          [todos[i], todos[j]] = [todos[j], todos[i]];
        }
        document.querySelectorAll('[data-portada] .art').forEach((el, i) => {
          const a = todos[i];
          el.style.setProperty('--g', a.foto ? `url('${a.foto}')` : el.dataset.degradado);
          el.href = a.enlace;
          if (a.enlace.startsWith('http')) el.target = '_blank'; else el.removeAttribute('target');
          el.querySelector('small').textContent = a.etiqueta;
          el.querySelector('span').textContent = a.nombre;
        });
      }
      pintar();
      setInterval(pintar, 30000); // revisa cada 30 s si ya toca cambiar, sin recargar la página
    })();
  </script>
</Base>
