# Configuración de la vitrina de Instagram (copiar a /etc/instagram-vitrina.env)

# Hashtag para elegir qué sale en la web (sin #). Vacío = salen todos los videos.
# Ejemplo: HASHTAG=interactivapublicidad
HASHTAG=

# 1 = solo videos y reels. 0 = también fotos.
SOLO_VIDEOS=1

# Cuántas publicaciones guardar como máximo.
MAXIMO=24
