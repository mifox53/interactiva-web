# Configuración de los titulares automáticos (copiar a /etc/noticias-feed.env). Todo es opcional.

# Cuántos días hacia atrás se aceptan titulares.
DIAS=7

# Máximo de titulares en total y por cada fuente.
MAX_TOTAL=40
MAX_POR_FUENTE=8

# Segundos de espera entre pedidos al mismo medio (para que no nos corte por «demasiados pedidos»).
PAUSA=10

# Dónde se guardan la última copia buena de cada feed y el informe de la última corrida.
CACHE=/var/lib/noticias-feed
